    {"id":"sl1","type":"text","x":45,"y":140,"width":900,"height":18,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":172008,"version":1,"versionNonce":173008,"isDeleted":false,"boundElements":null,"updated":1700000000000,"link":null,"locked":false,"text":"Phase 1 (Expand)  Add nullable first_name/last_name columns — name column untouched, no reader affected","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"middle","baseline":15,"containerId":null,"lineHeight":1.25},

    {"id":"sl2","type":"text","x":45,"y":180,"width":900,"height":18,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":172009,"version":1,"versionNonce":173009,"isDeleted":false,"boundElements":null,"updated":1700000000000,"link":null,"locked":false,"text":"Phase 2 (Dual-write)  Every new write updates BOTH name and first_name/last_name","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"middle","baseline":15,"containerId":null,"lineHeight":1.25},

    {"id":"sl3","type":"text","x":45,"y":220,"width":900,"height":18,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":172010,"version":1,"versionNonce":173010,"isDeleted":false,"boundElements":null,"updated":1700000000000,"link":null,"locked":false,"text":"Phase 3 (Backfill)  Background job splits name into first_name/last_name for rows written before Phase 2, throttled rate","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"middle","baseline":15,"containerId":null,"lineHeight":1.25},

