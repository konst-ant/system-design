    {
      "id": "ir8POFS4Aoeh996VKzn4t",
      "type": "stickynote",
      "x": 238.55921574043464,
      "y": 496.5,
      "width": 529.5142743217112,
      "height": 612,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffdf6b",
      "fillStyle": "solid",
