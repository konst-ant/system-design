    {
      "id": "v-WDyvTNtaG2fCMHm7xhd",
      "type": "text",
      "x": 248.52167251978221,
      "y": 85.5,
      "width": 485.3333435058594,
      "height": 320,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aBV",
      "roundness": null,
      "seed": 1971125378,
      "version": 1635,
      "versionNonce": 654202114,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791873452459,
      "created": 1791807959068,
      "link": null,
      "locked": false,
      "text": "C4 stands for:\n- Context\n- Container\n- Component\n- Code\n\n*) When zooming in through C4 we get to narrower audience:\nEverybody (PO, business, Scrum masters, Dev & Operational\nteams) >> Architects >> Developers \n\n*) Not necessarily all 4 levels required - many guys use only\nContext & Container. These 2 layers don't change much/fast.\nOn the opposite  Component/Code volatile with every feature\n\n*) Component/Code layers are the vehicle of tying up HLD to\nthe code/implementation level",
      "fontSize": 16,
      "baseFontSize": 24.106006198431025,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "F8pRIVaGTqscBVRrJTuV2",
      "originalText": "C4 stands for:\n- Context\n- Container\n- Component\n- Code\n\n*) When zooming in through C4 we get to narrower audience: Everybody (PO, business, Scrum masters, Dev & Operational teams) >> Architects >> Developers \n\n*) Not necessarily all 4 levels required - many guys use only Context & Container. These 2 layers don't change much/fast. On the opposite  Component/Code volatile with every feature\n\n*) Component/Code layers are the vehicle of tying up HLD to the code/implementation level",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
