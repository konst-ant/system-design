    {
      "id": "IB9K9p28ffRN1hoL1q4Ud",
      "type": "text",
      "x": -0.6563337877701372,
      "y": 118,
      "width": 379.3126675755403,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f5f5f5",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
